# =========================================================
# Wasla Healthcare Platform — Git Ignore Policy
# =========================================================

# ---------------------------------------------------------
# Compiled Output & Builds
# ---------------------------------------------------------
/dist
/tmp
/.tmp
/out-tsc
/bazel-out
/build

# ---------------------------------------------------------
# Dependencies & Package Managers
# ---------------------------------------------------------
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------
# Angular & Build Caches
# ---------------------------------------------------------
/.angular
/.angular/cache
/.angular/phase14-browser
.sass-cache/
/.vite
/.vite-temp
.eslintcache
.stylelintcache

# ---------------------------------------------------------
# Testing & Code Coverage
# ---------------------------------------------------------
/coverage
testem.log
/typings
__screenshots__/
vitest.results.json
/test-results
/playwright-report
/blob-report
/playwright/.cache

# ---------------------------------------------------------
# Local Testing & Verification Artifacts (Never Commit)
# ---------------------------------------------------------
/.playwright-mcp/
/docs/browser-verification/
/docs/jira-*.json
/docs/jira-*.md
/docs/phase*-*.txt
/scripts/audit-jira-endpoints.cjs
/scripts/browser-phase13.cjs
# (.impeccable/design.json is tracked intentionally)

# ---------------------------------------------------------
# Environment & Sensitive Credentials
# ---------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt

# ---------------------------------------------------------
# General Logs & Process Locks
# ---------------------------------------------------------
*.log
*.log.*
/connect.lock
/libpeerconnection.log
*.pid
*.seed
*.pid.lock

# ---------------------------------------------------------
# IDEs and Editors
# ---------------------------------------------------------
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# ---------------------------------------------------------
# Operating System Files
# ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------
# Temporary & Scratch Files
# ---------------------------------------------------------
scratch/
*.tmp
*.temp
*~
*.bak
*.swp
*.swo
*.orig
*.rej
