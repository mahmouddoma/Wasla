{
  "name": "wasla",
  "version": "0.0.0",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.cjs && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}